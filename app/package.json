{
  "name": "the-age-of-capital-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Représentation visuelle du POC : carte PixiJS, interface Vue 3, moteur Rust en WebAssembly",
  "scripts": {
    "wasm": "cd ../sim-wasm && cargo build --release --target wasm32-unknown-unknown && cp target/wasm32-unknown-unknown/release/sim_wasm.wasm ../app/public/sim_wasm.wasm",
    "assets": "cd ../graphGeneration && python3 generate_assets.py",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "artifact": "vite build && node tools/artifact.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.9.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
